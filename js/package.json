{
  "name": "@nearai/inference-sdk",
  "version": "0.1.0-rc.3",
  "description": "Verify NEAR AI Cloud attestation evidence in TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearai/inference-sdk.git",
    "directory": "js"
  },
  "homepage": "https://github.com/nearai/inference-sdk#readme",
  "bugs": {
    "url": "https://github.com/nearai/inference-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsup --clean",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "jest --runInBand",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "lint": "biome lint .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@freedomofpress/sigstore-browser": "0.1.14",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@peculiar/x509": "2.1.0",
    "@phala/dcap-qvl": "0.6.3",
    "buffer": "^6.0.3",
    "ed2curve": "0.3.0",
    "ethers": "^6.17.0",
    "hpke": "1.1.7",
    "jose": "6.2.12",
    "ohttp-ts": "0.6.0",
    "openai": "7.20.0",
    "reflect-metadata": "0.2.2",
    "tweetnacl": "^1.0.3",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/ed2curve": "0.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
